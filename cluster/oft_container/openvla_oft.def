Bootstrap: docker
From: ubuntu:24.04

# OpenVLA-OFT(+) runtime for Turing (docs/oft_reference.md). Same skeleton as
# cluster/liberoplus_container/liberoplus.def (the image the TurboVLA runs used):
# - Ubuntu 24.04 base: rootless builds fall back to the host fakeroot, which needs glibc >= 2.38 in the image.
# - EGL: libglvnd loader + NVIDIA vendor file; `apptainer exec --nv` binds the driver. Mesa EGL as CPU fallback.
# - Python 3.10 (uv) with requirements.lock.txt: OpenVLA-OFT's pins (torch 2.2.0+cu121, the moojink transformers
#   fork = 4.40.1 + bidirectional attention in LlamaSdpaAttention, peft 0.11.1, timm 0.9.10, TF 2.15) and the
#   LIBERO-Plus simulator pins of the TurboVLA image (mujoco 3.2.0, robosuite 1.4.1, ...).
# - NO flash-attn: OFT's bidirectional attention exists only in the fork's SDPA path; flash-attn would be causal.
# - 9 pins are source-only (8 pure Python + evdev/egl_probe), hence build-essential, cmake and libegl-dev.
# Code (openvla-oft, LIBERO-plus) and weights stay outside the image (see oft-exec.sh).

%files
    requirements.lock.txt /opt/requirements.lock.txt

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    # Rootless build: apt can't drop privileges to the _apt user.
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-no-sandbox-user
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential cmake libegl-dev \
        libglvnd0 libegl1 libgl1 libgles2 libopengl0 libegl-mesa0 \
        libmagickwand-dev libfontconfig1 libexpat1 \
        libglib2.0-0 libsm6 libxext6 libxrender1
    rm -rf /var/lib/apt/lists/*

    # NVIDIA EGL vendor file (libEGL_nvidia.so.0 itself is bound in by --nv at run time)
    mkdir -p /usr/share/glvnd/egl_vendor.d
    printf '{\n  "file_format_version" : "1.0.0",\n  "ICD" : { "library_path" : "libEGL_nvidia.so.0" }\n}\n' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

    # uv + standalone Python 3.10, then the pinned environment (git+ pins need git, installed above)
    curl -LsSf https://astral.sh/uv/0.7.2/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_NO_CACHE=1
    uv python install 3.10
    uv venv /opt/venv --python 3.10
    uv pip install --python /opt/venv/bin/python -r /opt/requirements.lock.txt \
        --extra-index-url https://download.pytorch.org/whl/cu121 --index-strategy unsafe-best-match

    # Build-time gate: the installed transformers must be the OFT fork (bidirectional SDPA attention).
    grep -q "is_causal=False" /opt/venv/lib/python3.10/site-packages/transformers/models/llama/modeling_llama.py \
        || { echo "transformers is not the moojink OFT fork"; exit 1; }
    ! /opt/venv/bin/python -c "import flash_attn" 2>/dev/null || { echo "flash_attn must not be installed"; exit 1; }

%environment
    export PATH=/opt/venv/bin:$PATH
    export MUJOCO_GL=egl
    export PYOPENGL_PLATFORM=egl
    export PYTHONNOUSERSITE=1
    # robosuite JIT-compiles with numba cache=True; the image is read-only, so cache in a writable temp dir.
    export NUMBA_CACHE_DIR=${NUMBA_CACHE_DIR:-/tmp/numba-cache-${USER:-user}}
    export TF_CPP_MIN_LOG_LEVEL=2
    export WANDB_MODE=${WANDB_MODE:-offline}

%test
    /opt/venv/bin/python - <<'EOF'
import torch, torchvision, transformers, peft, timm, accelerate, tensorflow as tf, tensorflow_datasets, dlimp
import mujoco, robosuite, wand.image, skimage, cv2
from transformers.models.llama import modeling_llama
import inspect
assert "is_causal=False" in inspect.getsource(modeling_llama.LlamaSdpaAttention.forward), "not the OFT fork"
assert transformers.__version__ == "4.40.1" and peft.__version__ == "0.11.1" and timm.__version__ == "0.9.10"
print("torch", torch.__version__, "| transformers", transformers.__version__, "(OFT fork) | peft", peft.__version__,
      "| timm", timm.__version__, "| accelerate", accelerate.__version__, "| tensorflow", tf.__version__,
      "| mujoco", mujoco.__version__, "| robosuite", robosuite.__version__)
EOF

%labels
    Description OpenVLA-OFT(+) training/evaluation runtime with LIBERO / LIBERO-Plus (EGL rendering via --nv)
    Base Ubuntu 24.04; Python 3.10 (uv), torch 2.2.0+cu121, transformers 4.40.1 (moojink OFT fork), mujoco 3.2.0

%help
    Normally used through oft-exec.sh (mounts the LIBERO-Plus assets, sets PYTHONPATH to the code checkouts).
