Bootstrap: docker
From: ubuntu:24.04

# LIBERO-Plus / TurboVLA runtime for Turing.
# - Ubuntu 24.04 base: Turing builds are rootless and fall back to the host's fakeroot library, which needs
#   glibc >= 2.38 inside the image (22.04-based images fail with "GLIBC_2.38 not found", job 2390476).
# - GPU rendering: libglvnd EGL loader + NVIDIA EGL vendor file here; `apptainer exec --nv` binds the driver
#   (same setup as nvidia/opengl:1.2-glvnd-runtime, verified on Turing A30s: MuJoCo EGL ~2,300 renders/s).
#   Mesa EGL is included as a CPU fallback (__EGL_VENDOR_LIBRARY_FILENAMES=.../50_mesa.json).
# - Python 3.10 (uv-managed) with the pins of the desktop env, except mujoco 3.1.6 -> 3.2.0: 3.1.6's model compiler
#   never closes mesh files (thousands of leaked file handles per LIBERO-Plus Layout scene); 3.2.0 fixes it and works
#   with robosuite 1.4.1 (physics vs 3.1.6: max qpos diff ~1e-8 after 300 random steps). Code/assets stay outside.
#   10 pins are source-only on PyPI; 8 are pure Python, evdev needs build-essential, egl_probe needs cmake + libegl-dev.

%files
    requirements.lock.txt /opt/requirements.lock.txt

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    # Rootless build: apt can't drop privileges to the _apt user.
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-no-sandbox-user
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git build-essential cmake libegl-dev \
        libglvnd0 libegl1 libgl1 libgles2 libopengl0 libegl-mesa0 \
        libmagickwand-dev libfontconfig1 libexpat1 \
        libglib2.0-0 libsm6 libxext6 libxrender1
    rm -rf /var/lib/apt/lists/*

    # NVIDIA EGL vendor file (the library itself, libEGL_nvidia.so.0, is bound in by --nv at run time)
    mkdir -p /usr/share/glvnd/egl_vendor.d
    printf '{\n  "file_format_version" : "1.0.0",\n  "ICD" : { "library_path" : "libEGL_nvidia.so.0" }\n}\n' \
        > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

    # uv + standalone Python 3.10, then the pinned environment
    curl -LsSf https://astral.sh/uv/0.7.2/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh
    export UV_PYTHON_INSTALL_DIR=/opt/python UV_NO_CACHE=1
    uv python install 3.10
    uv venv /opt/venv --python 3.10
    uv pip install --python /opt/venv/bin/python -r /opt/requirements.lock.txt \
        --extra-index-url https://download.pytorch.org/whl/cu121 --index-strategy unsafe-best-match

    # Mount point for the LIBERO-Plus assets squashfs (see lp-exec.sh)
    mkdir -p /opt/liberoplus_assets

%environment
    export PATH=/opt/venv/bin:$PATH
    export MUJOCO_GL=egl
    export PYOPENGL_PLATFORM=egl
    export PYTHONNOUSERSITE=1
    # robosuite JIT-compiles with numba cache=True; the image is read-only, so cache in a writable temp dir.
    export NUMBA_CACHE_DIR=${NUMBA_CACHE_DIR:-/tmp/numba-cache-${USER:-user}}

%test
    /opt/venv/bin/python - <<'EOF'
import torch, mujoco, robosuite, tensorflow, transformers, wand.image
print("torch", torch.__version__, "| mujoco", mujoco.__version__, "| robosuite", robosuite.__version__,
      "| tensorflow", tensorflow.__version__, "| transformers", transformers.__version__, "| wand OK")
EOF

%labels
    Description LIBERO-Plus + TurboVLA evaluation/training runtime (EGL rendering via --nv)
    Base Ubuntu 24.04; Python 3.10 (uv), torch 2.3.1+cu121, mujoco 3.2.0, robosuite 1.4.1

%help
    Run with GPU rendering:   apptainer exec --nv liberoplus.sif python ...
    Normally used through lp-exec.sh, which also mounts the assets squashfs and sets PYTHONPATH.
