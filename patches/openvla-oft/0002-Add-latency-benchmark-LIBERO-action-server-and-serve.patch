+"""
+bench_latency.py
+
+Controlled inference benchmark for OpenVLA-OFT on LIBERO inputs: batch 1, a fixed
+observation (experiments/robot/libero/sample_libero_spatial_observation.pkl), N warm-up then M timed queries.
+
+Reports median / p95 / mean (ms) for
+  - end_to_end: get_action() as run_libero_eval.py calls it (preprocessing, vision, LLM, action head, un-normalize;
+                returns numpy, so the GPU work is synchronized)
+  - vision:     vision_backbone forward            (CUDA events)
+  - projector:  projector forward                  (CUDA events)
+  - llm:        language_model forward             (CUDA events; Llama-2 layers + final norm + lm_head)
+plus the LLM sequence length, analytic LLM FLOPs (per decoder layer, all layers, lm_head), peak GPU memory and the
+software/GPU versions. Writes a JSON file.
+
+    python experiments/robot/bench_latency.py --pretrained_checkpoint <dir> --out bench.json
+"""
+
+import argparse
+import copy
+import json
+import os
+import pickle
+import platform
+import sys
+import time
+
+import numpy as np
+import torch
+
+sys.argv.append("libero")  # select LIBERO constants in prismatic.vla.constants (as the eval/finetune scripts do)
+
+from experiments.robot.libero.run_libero_eval import GenerateConfig, initialize_model  # noqa: E402
+from experiments.robot.robot_utils import get_action  # noqa: E402
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def stats(xs):
+    a = np.asarray(xs) * 1000.0
+    return {"median_ms": float(np.median(a)), "p95_ms": float(np.percentile(a, 95)), "mean_ms": float(a.mean()), "n": len(a)}
+
+
+def llm_flops(cfg_text, seq_len):
+    """Analytic forward FLOPs of the Llama decoder (2 FLOPs per multiply-add)."""
+    d, f, v = cfg_text.hidden_size, cfg_text.intermediate_size, cfg_text.vocab_size
+    kv = d * cfg_text.num_key_value_heads // cfg_text.num_attention_heads
+    proj = 2 * seq_len * (2 * d * d + 2 * d * kv)   # q, o (d x d) and k, v (d x kv)
+    mlp = 2 * seq_len * 3 * d * f                  # gate, up, down
+    attn = 2 * 2 * seq_len * seq_len * d           # QK^T and AV
+    per_layer = proj + mlp + attn
+    return {"per_layer_gflops": per_layer / 1e9, "num_layers": cfg_text.num_hidden_layers,
+            "all_layers_gflops": per_layer * cfg_text.num_hidden_layers / 1e9,
+            "lm_head_gflops": 2 * seq_len * d * v / 1e9}
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--pretrained_checkpoint", required=True)
+    ap.add_argument("--unnorm_key", default="libero_spatial")
+    ap.add_argument("--warmup", type=int, default=100)
+    ap.add_argument("--iters", type=int, default=500)
+    ap.add_argument("--load_in_8bit", action="store_true")
+    ap.add_argument("--out", required=True)
+    args, _ = ap.parse_known_args()
+
+    cfg = GenerateConfig(
+        pretrained_checkpoint=args.pretrained_checkpoint, task_suite_name=args.unnorm_key,
+        use_l1_regression=True, use_diffusion=False, use_film=False, num_images_in_input=2, use_proprio=True,
+        center_crop=True, load_in_8bit=args.load_in_8bit,
+    )
+    torch.manual_seed(7)
+    model, action_head, proprio_projector, noisy_action_projector, processor = initialize_model(cfg)
+    obs0 = pickle.load(open(os.path.join(HERE, "libero", "sample_libero_spatial_observation.pkl"), "rb"))
+
+    # CUDA-event timers on module forwards; also capture the LLM sequence length.
+    timers, current, seq = {}, {}, {}
+
+    def add_timer(name, module):
+        def pre(mod, args, kwargs):
+            ev = torch.cuda.Event(enable_timing=True)
+            ev.record()
+            current[name] = ev
+            if name == "llm":
+                emb = kwargs.get("inputs_embeds")
+                seq["len"] = int(emb.shape[1]) if emb is not None else int(kwargs["input_ids"].shape[1])
+
+        def post(mod, args, kwargs, out):
+            ev = torch.cuda.Event(enable_timing=True)
+            ev.record()
+            timers.setdefault(name, []).append((current.pop(name), ev))
+
+        module.register_forward_pre_hook(pre, with_kwargs=True)
+        module.register_forward_hook(post, with_kwargs=True)
+
+    add_timer("vision", model.vision_backbone)
+    add_timer("projector", model.projector)
+    add_timer("llm", model.language_model)
+
+    def query():
+        obs = copy.deepcopy(obs0)  # get_vla_action normalizes obs["state"] in place
+        return get_action(cfg, model, obs, obs["task_description"], processor=processor, action_head=action_head,
+                          proprio_projector=proprio_projector, noisy_action_projector=noisy_action_projector,
+                          use_film=False)
+
+    for _ in range(args.warmup):
+        query()
+    torch.cuda.synchronize()
+    timers.clear()
+    torch.cuda.reset_peak_memory_stats()
+    e2e, actions = [], None
+    for _ in range(args.iters):
+        t0 = time.perf_counter()
+        actions = query()
+        e2e.append(time.perf_counter() - t0)
+    torch.cuda.synchronize()
+
+    result = {
+        "checkpoint": args.pretrained_checkpoint, "load_in_8bit": args.load_in_8bit,
+        "warmup": args.warmup, "iters": args.iters, "batch": 1,
+        "end_to_end": stats(e2e),
+        **{k: stats([a.elapsed_time(b) / 1000.0 for a, b in v]) for k, v in timers.items()},
+        "llm_seq_len": seq.get("len"),
+        "llm_flops": llm_flops(model.language_model.config, seq.get("len", 0)),
+        "attn_implementation": model.language_model.config._attn_implementation,
+        "attn_class": type(model.language_model.model.layers[0].self_attn).__name__,
+        "peak_gpu_mem_gb": torch.cuda.max_memory_allocated() / 2**30,
+        "action_chunk_shape": list(np.asarray(actions).shape),
+        "gpu": torch.cuda.get_device_name(0), "torch": torch.__version__,
+        "cuda": torch.version.cuda, "python": platform.python_version(),
+    }
+    import transformers
+    result["transformers"] = transformers.__version__
+    json.dump(result, open(args.out, "w"), indent=1)
+    print(json.dumps(result, indent=1))
+
+
+if __name__ == "__main__":
+    main()
