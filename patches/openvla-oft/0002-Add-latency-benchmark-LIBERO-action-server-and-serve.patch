+"""
+check_server.py
+
+Equivalence test for oft_libero_server.py + the eval kit's openvla_oft adapter.
+Loads OFT once, serves it over HTTP from a background thread, runs one real LIBERO(-Plus) episode with actions from the
+HTTP path, and at every query compares them with a direct in-process call on the same observation. Passes if every
+chunk is identical (max |diff| == 0).
+
+    python experiments/robot/libero/check_server.py --pretrained_checkpoint <dir> --kit_dir <eval kit> [--queries 30]
+"""
+
+import argparse
+import sys
+import threading
+import time
+
+import numpy as np
+
+sys.argv.append("libero")
+
+from libero.libero import benchmark  # noqa: E402
+
+from experiments.robot.libero.libero_utils import get_libero_dummy_action, get_libero_env  # noqa: E402
+from experiments.robot.libero.oft_libero_server import OFTLiberoPolicy, make_app  # noqa: E402
+from experiments.robot.libero.run_libero_eval import GenerateConfig  # noqa: E402
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--pretrained_checkpoint", required=True)
+    ap.add_argument("--kit_dir", required=True)
+    ap.add_argument("--suite", default="libero_spatial")
+    ap.add_argument("--task_id", type=int, default=0)
+    ap.add_argument("--queries", type=int, default=30)
+    ap.add_argument("--port", type=int, default=8790)
+    args, _ = ap.parse_known_args()
+
+    cfg = GenerateConfig(pretrained_checkpoint=args.pretrained_checkpoint, task_suite_name=args.suite,
+                         use_l1_regression=True, use_diffusion=False, use_film=False, num_images_in_input=2,
+                         use_proprio=True, center_crop=True)
+    policy = OFTLiberoPolicy(cfg)
+
+    import uvicorn
+
+    server = uvicorn.Server(uvicorn.Config(make_app(policy), host="127.0.0.1", port=args.port, log_level="warning"))
+    threading.Thread(target=server.run, daemon=True).start()
+
+    import os
+
+    sys.path.insert(0, args.kit_dir)
+    os.environ["OFT_SERVER_URL"] = f"http://127.0.0.1:{args.port}"
+    from adapters.openvla_oft import OpenVLAOFTAdapter
+
+    adapter = OpenVLAOFTAdapter()
+
+    task_suite = benchmark.get_benchmark_dict()[args.suite]()
+    task = task_suite.get_task(args.task_id)
+    env, description = get_libero_env(task, cfg.model_family, resolution=256)
+    env.reset()
+    obs = env.set_init_state(task_suite.get_task_init_states(args.task_id)[0])
+    for _ in range(10):
+        obs, _, _, _ = env.step(get_libero_dummy_action(cfg.model_family))
+
+    max_diff, n, done, t_http = 0.0, 0, False, []
+    while n < args.queries and not done:
+        t0 = time.perf_counter()
+        via_http = adapter.predict(obs, task.language)
+        t_http.append(time.perf_counter() - t0)
+        direct = policy.act(obs, task.language)
+        assert via_http.shape == direct.shape, (via_http.shape, direct.shape)
+        max_diff = max(max_diff, float(np.abs(via_http - direct).max()))
+        n += 1
+        for a in via_http:
+            obs, _, done, _ = env.step(a.tolist())
+            if done:
+                break
+    print(f"task: {task.language}")
+    print(f"queries compared: {n}, chunk shape {via_http.shape}, episode done: {done}")
+    print(f"HTTP query median {np.median(t_http[1:] or t_http) * 1000:.1f} ms")
+    print(f"max |HTTP - direct| = {max_diff}")
+    print("RESULT:", "server path identical to in-process path" if max_diff == 0 else "server path DIFFERS")
+    sys.exit(0 if max_diff == 0 else 1)
+
+
+if __name__ == "__main__":
+    main()
