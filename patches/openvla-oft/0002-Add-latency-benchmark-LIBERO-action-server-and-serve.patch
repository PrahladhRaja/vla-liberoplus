+"""
+oft_libero_server.py
+
+HTTP server that answers LIBERO action queries with OpenVLA-OFT. It lets one model
+process per GPU serve several CPU environment workers (the LIBERO-Plus eval kit).
+
+Each request is handled with run_libero_eval.py's own functions, so preprocessing and action post-processing are
+identical to OFT's evaluation:
+    raw LIBERO obs -> prepare_observation() -> get_action() -> process_action() per action -> (chunk, 7) array
+Requests are served one at a time (a lock around the model).
+
+    POST /act     {"obs": {"agentview_image", "robot0_eye_in_hand_image", "robot0_eef_pos", "robot0_eef_quat",
+                           "robot0_gripper_qpos"}, "instruction": str}  -> json_numpy array (chunk, 7)
+    GET  /health  -> {"ok": true, "queries": n}
+
+    python experiments/robot/libero/oft_libero_server.py --pretrained_checkpoint <dir> --port 8777
+"""
+
+import json_numpy
+
+json_numpy.patch()
+
+import argparse  # noqa: E402
+import sys  # noqa: E402
+import threading  # noqa: E402
+from typing import Any, Dict  # noqa: E402
+
+import numpy as np  # noqa: E402
+
+sys.argv.append("libero")  # select LIBERO constants in prismatic.vla.constants
+
+from experiments.robot.libero.run_libero_eval import (  # noqa: E402
+    GenerateConfig,
+    initialize_model,
+    prepare_observation,
+    process_action,
+)
+from experiments.robot.robot_utils import get_action, get_image_resize_size  # noqa: E402
+
+OBS_KEYS = ("agentview_image", "robot0_eye_in_hand_image", "robot0_eef_pos", "robot0_eef_quat", "robot0_gripper_qpos")
+
+
+class OFTLiberoPolicy:
+    """Loads the model once; act() maps one raw LIBERO observation + instruction to an executable action chunk."""
+
+    def __init__(self, cfg: GenerateConfig):
+        self.cfg = cfg
+        (self.model, self.action_head, self.proprio_projector,
+         self.noisy_action_projector, self.processor) = initialize_model(cfg)  # also sets cfg.unnorm_key
+        self.resize_size = get_image_resize_size(cfg)
+        self.lock = threading.Lock()
+        self.queries = 0
+
+    def act(self, obs: dict, instruction: str) -> np.ndarray:
+        observation, _ = prepare_observation(obs, self.resize_size)
+        with self.lock:
+            actions = get_action(self.cfg, self.model, observation, instruction, processor=self.processor,
+                                 action_head=self.action_head, proprio_projector=self.proprio_projector,
+                                 noisy_action_projector=self.noisy_action_projector, use_film=self.cfg.use_film)
+            self.queries += 1
+        return np.stack([process_action(np.asarray(a), self.cfg.model_family) for a in actions]).astype(np.float64)
+
+
+def make_app(policy: OFTLiberoPolicy):
+    from fastapi import FastAPI
+    from fastapi.responses import JSONResponse
+
+    app = FastAPI()
+
+    @app.post("/act")
+    def act(payload: Dict[str, Any]):  # same body type as vla-scripts/deploy.py
+        obs = {k: np.asarray(payload["obs"][k]) for k in OBS_KEYS}
+        return JSONResponse(json_numpy.dumps(policy.act(obs, payload["instruction"])))
+
+    @app.get("/health")
+    def health():
+        return {"ok": True, "queries": policy.queries}
+
+    return app
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--pretrained_checkpoint", required=True)
+    ap.add_argument("--unnorm_key", default="libero_spatial")  # OFT+ stores the same mix stats under all 4 suites
+    ap.add_argument("--host", default="127.0.0.1")
+    ap.add_argument("--port", type=int, default=8777)
+    args, _ = ap.parse_known_args()
+    cfg = GenerateConfig(
+        pretrained_checkpoint=args.pretrained_checkpoint, task_suite_name=args.unnorm_key,
+        use_l1_regression=True, use_diffusion=False, use_film=False, num_images_in_input=2, use_proprio=True,
+        center_crop=True,
+    )
+    policy = OFTLiberoPolicy(cfg)
+    import uvicorn
+
+    uvicorn.run(make_app(policy), host=args.host, port=args.port, log_level="warning")
+
+
+if __name__ == "__main__":
+    main()
